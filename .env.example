# Copie para .env e preencha. O .env está no .gitignore e nunca deve ser commitado.
# Chave do Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Reclamações por chamada ao modelo. Default 10, faixa de 2 a 25 — fora disso a
# execução encerra antes de qualquer chamada paga.
TAMANHO_LOTE=
# Modelo do Gemini. Default gemini-3.6-flash, pinado de propósito: alias móvel
# invalida a comparação de F1 entre execuções.
MODELO=
